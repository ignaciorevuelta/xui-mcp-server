# --- Connection -------------------------------------------------------------
# Reseller API base. The trailing slash matters: most panels 301-redirect to
# add it, and some addons 404 without it.
XUI_URL=http://panel.example.com:8880/YourAddon/

# API key issued by the panel for the reseller addon.
XUI_API_KEY=

# server_id sent when creating lines. Single-streamer panels use 1.
XUI_SERVER_ID=1

# Per-request timeout in milliseconds.
XUI_TIMEOUT_MS=20000

# --- Admin API (optional) ---------------------------------------------------
# Unlocks the panel's full management surface: users, lines, streams, bouquets,
# packages, providers, EPG, MAG/Enigma devices, access codes and log feeds.
#
# These are NOT the reseller values above. In the panel, create an access code
# whose type is "Admin API" (Management > Access Control > Access Codes) and use
# an administrator account's api_key.
XUI_ADMIN_URL=
XUI_ADMIN_API_KEY=

# --- Server provisioning (ON by default) -------------------------------------
# The provisioning tools open a ROOT SSH SESSION on a target machine and install
# software on it. They are enabled out of the box because standing panels up is
# what this server is for.
#
# Set to false to remove remote execution from this server entirely.
XUI_ALLOW_PROVISIONING=true

# Comma-separated hosts provisioning may touch. Empty (the default) means any
# host. Pin it if this server runs anywhere you do not fully control.
XUI_PROVISION_HOSTS=

# What an install actually does: XUI.ONE is abandonware with no official
# download, so the payload and licence patch are fetched from community mirrors
# and executed as root on the target. Both are pinned by SHA-256 and the install
# aborts on a mismatch, but they remain unsigned third-party binaries.

# --- Safety -----------------------------------------------------------------
# Mutating actions are OFF by default so this server is safe to point at a
# production panel. Turn them on deliberately.
#
# XUI_ALLOW_WRITES enables create_line, create_trial, renew_line and
# add_reseller_credits.
XUI_ALLOW_WRITES=false

# XUI_ALLOW_DELETE additionally enables delete_line. Deleting a line cancels a
# customer's service and cannot be undone through this API. Requires
# XUI_ALLOW_WRITES=true as well.
XUI_ALLOW_DELETE=false

# --- Local mock (npm run mock) ----------------------------------------------
# XUI_URL=http://127.0.0.1:8899/
# XUI_API_KEY=test-key
